# Copy to .env for local configuration.
# Do not commit .env. Do not put real secrets in this file.

APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://pulse:pulse@localhost:5432/pulse
REDIS_URL=redis://localhost:6379/0
NEXT_PUBLIC_API_URL=http://localhost:8000

# Required when APP_ENV=production. Leave unset locally to keep authenticated routes closed.
