# Copy to .env for local configuration.
# Do not commit .env. Do not put real secrets in this file.

APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://pulse:pulse@localhost:5432/pulse
REDIS_URL=redis://localhost:6379/0
NEXT_PUBLIC_API_URL=http://localhost:8000

# Required when APP_ENV=production. Leave unset locally to keep authenticated routes closed.
# CLERK_ISSUER=https://example.clerk.accounts.dev
# CLERK_JWKS_URL=
# CLERK_SECRET_KEY=
# The web app uses the same Clerk application. The publishable key is public.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Required when APP_ENV=production. 32-byte key, base64-encoded.
# python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# INTEGRATION_ENCRYPTION_KEY=

# Gmail OAuth. The only scope Pulse requests is gmail.readonly (restricted).
# Public production use that stores Gmail data requires Google's OAuth verification.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/gmail/callback
# WEB_APP_URL=http://localhost:3000
